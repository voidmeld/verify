local screen = Instance.new("ScreenGui")
screen.IgnoreGuiInset = true
screen.Parent = game:GetService("Players").LocalPlayer.PlayerGui
local function near(actual, expected, label)
    assert(math.abs(actual - expected) < 0.001, label .. ": " .. actual .. " ~= " .. expected)
end
local ok, failure = pcall(function()
    for _, observation in expected do
        local config = observation.config
        local direction = Enum.FillDirection[observation.direction]
        local horizontal = direction == Enum.FillDirection.Horizontal
            local frame = Instance.new("Frame")
            frame.Size = UDim2.fromOffset(if horizontal then config.length else 100, if horizontal then 100 else config.length)
            frame.Parent = screen
            local list = Instance.new("UIListLayout")
            list.SortOrder = Enum.SortOrder.LayoutOrder
            list.FillDirection = direction
            list.Padding = UDim.new(0, 8)
            list[if horizontal then "HorizontalFlex" else "VerticalFlex"] = Enum.UIFlexAlignment[config.main or "None"]
            list[if horizontal then "VerticalFlex" else "HorizontalFlex"] = Enum.UIFlexAlignment[config.cross or "None"]
            list.ItemLineAlignment = Enum.ItemLineAlignment[config.line or "Automatic"]
            list[if horizontal then "HorizontalAlignment" else "VerticalAlignment"] =
                if horizontal then Enum.HorizontalAlignment[config.alignment or "Left"] else Enum.VerticalAlignment[config.alignment or "Top"]
            list.Parent = frame
            local cells = {}
            for index, basis in config.basis do
                local cell = Instance.new("Frame")
                cell.Size = UDim2.fromOffset(if horizontal then basis else index * 10, if horizontal then index * 10 else basis)
                cell.LayoutOrder, cell.Parent = index, frame
                if config.modes and config.modes[index] then
                    local item = Instance.new("UIFlexItem")
                    item.FlexMode = Enum.UIFlexMode[config.modes[index]]
                    item.GrowRatio = config.grow and config.grow[index] or 0
                    item.ShrinkRatio = config.shrink and config.shrink[index] or 0
                    item.ItemLineAlignment = Enum.ItemLineAlignment[config.itemAlign and config.itemAlign[index] or "Automatic"]
                    item.Parent = cell
                end
                if config.min and config.min[index] > 0 or config.max and config.max[index] > 0 or config.maxCross and config.maxCross[index] > 0 then
                    local constraint = Instance.new("UISizeConstraint")
                    local low, high = constraint.MinSize, constraint.MaxSize
                    local minimum = config.min and config.min[index] or 0
                    local maximum = config.max and config.max[index] or (if horizontal then high.X else high.Y)
                    local crossMaximum = config.maxCross and config.maxCross[index] or (if horizontal then high.Y else high.X)
                    constraint.MinSize = Vector2.new(if horizontal then minimum else low.X, if horizontal then low.Y else minimum)
                    constraint.MaxSize = Vector2.new(if horizontal then maximum else crossMaximum, if horizontal then crossMaximum else maximum)
                    constraint.Parent = cell
                end
                cells[index] = cell
            end
            task.wait(0.05)

            for index, cell in cells do
                local at = cell.AbsolutePosition - frame.AbsolutePosition
local actual = {at.X, at.Y, cell.AbsoluteSize.X, cell.AbsoluteSize.Y}
                for axis = 1, 4 do
                    near(actual[axis], observation.cells[index][axis], config.name .. " cell " .. index .. " axis " .. axis)
                end
            end
        near(list.AbsoluteContentSize.X, observation.extent[1], config.name .. " content width")
        near(list.AbsoluteContentSize.Y, observation.extent[2], config.name .. " content height")
        frame:Destroy()
    end
end)
